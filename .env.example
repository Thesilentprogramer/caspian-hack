CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com

FEATHERLESS_API_KEY=
# Llama 3.x is HuggingFace-gated on Featherless. Use Qwen or Gemma 4.
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

CASPIAN_EMAIL_USERNAME=privacy-guard
CASPIAN_SLACK_DISPLAY_NAME=Privacy Guard

# Optional. Unset = all seven Categories. Empty = redact nothing.
# PRIVACY_GUARD_CATEGORIES=EMAIL,IP_ADDRESS,API_KEY,CREDIT_CARD,PHONE,PERSON,ORG

# Optional Telegram bot token from @BotFather. Slack/Email still boot without it.
# TELEGRAM_BOT_TOKEN=

# Local dashboard in the agent process (never bind off loopback).
PRIVACY_GUARD_DASHBOARD_PORT=8787

# Optional. Required only for `privacy-guard-mcp --http`. Distinct from CASPIAN_API_KEY.
# MCP_AUTH_TOKEN=
